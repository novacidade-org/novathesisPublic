\newif\ifims@chapter@meta@printed
\newcounter{ims@chapter@metaid}
\newcounter{ims@chapter@corcounter}
\newcounter{ims@chapter@affcounter}
\def\ims@chapter@meta@printed{0}

\def\ims@aff@organization{}
\def\ims@aff@city{}
\def\ims@aff@country{}
\define@key{imsaff}{organization}{\def\ims@aff@organization{#1}}
\define@key{imsaff}{city}{\def\ims@aff@city{#1}}
\define@key{imsaff}{country}{\def\ims@aff@country{#1}}

\newcommand{\ims@chapter@resetmeta}{%
  \stepcounter{ims@chapter@metaid}%
  \gdef\ims@chapter@meta@printed{0}%
  \global\setcounter{ims@chapter@corcounter}{0}%
  \global\setcounter{ims@chapter@affcounter}{0}%
  \gdef\ims@chapter@authors{}%
  \gdef\ims@chapter@afforder{}%
  \gdef\ims@chapter@cortexts{}%
}

\newcommand{\ims@corsymbol}[1]{%
  \ifcase#1\or *\or \dagger\or \ddagger\or \S\or \P\or \|\or **\or \dagger\dagger\else *\fi%
}

\newcommand{\ims@getcorlabel}[1]{%
  \edef\ims@currentcorcs{ims@chapter@corlabel@\number\value{ims@chapter@metaid}@#1}%
  \ifcsdef{\ims@currentcorcs}{%
    \edef\ims@currentcorlabel{\csuse{\ims@currentcorcs}}%
  }{%
    \stepcounter{ims@chapter@corcounter}%
    \edef\ims@currentcorlabel{\ims@corsymbol{\value{ims@chapter@corcounter}}}%
    \csdef{\ims@currentcorcs}{\ims@currentcorlabel}%
  }%
}

\newcommand{\ims@appendaffid}[1]{%
  \ifstrempty{#1}{}{%
    \edef\ims@currentaffseencs{ims@chapter@affseen@\number\value{ims@chapter@metaid}@#1}%
    \ifcsdef{\ims@currentaffseencs}{}{%
      \csdef{\ims@currentaffseencs}{1}%
      \ifdefempty{\ims@chapter@afforder}{%
        \gdef\ims@chapter@afforder{#1}%
      }{%
        \xappto\ims@chapter@afforder{,#1}%
      }%
    }%
  }%
}

\newcommand{\ims@appendaffidlist}[1]{%
  \ifstrempty{#1}{}{%
    \forcsvlist{\ims@appendaffid}{#1}%
  }%
}

\newcommand{\ims@chapter@author}[2][]{%
  \def\ims@currentauthor{#2}%
  \ifstrempty{#1}{}{%
    \g@addto@macro\ims@currentauthor{\textsuperscript{#1}}%
    \ims@appendaffidlist{#1}%
  }%
  \protected@xappto\ims@chapter@authors{%
    \noexpand\noindent\expandonce{\ims@currentauthor}\noexpand\par%
  }%
}

\newcommand{\ims@chapter@affiliation}[2][]{%
  \ims@storeaffiliation{#1}{#2}%
}

\newcommand{\ims@chapter@corref}[1]{%
  \ims@getcorlabel{#1}%
  \textsuperscript{\ims@currentcorlabel}%
}

\newcommand{\ims@chapter@cortext}[2][]{%
  \def\ims@currentcorkey{#1}%
  \ifdefempty{\ims@currentcorkey}{\def\ims@currentcorkey{default}}{}%
  \ims@getcorlabel{\ims@currentcorkey}%
  \protected@edef\ims@currentcorline{%
    \noexpand\noindent\noexpand\textsuperscript{\ims@currentcorlabel}#2\noexpand\par%
  }%
  \protected@xappto\ims@chapter@cortexts{\expandonce{\ims@currentcorline}}%
}

\providecommand{\corref}[1]{}
\providecommand{\cortext}[2][]{}
\providecommand{\affiliation}[2][]{}

\newcommand{\ims@storeaffiliation}[2]{%
  \def\ims@aff@organization{}%
  \def\ims@aff@city{}%
  \def\ims@aff@country{}%
  \setkeys{imsaff}{#2}%
  \def\ims@currentaff{}%
  \ifdefempty{\ims@aff@organization}{%
    \protected@edef\ims@currentaff{#2}%
  }{%
    \protected@edef\ims@currentaff{\ims@aff@organization}%
  }%
  \ifdefempty{\ims@aff@city}{}{%
    \ifdefempty{\ims@currentaff}{%
      \protected@edef\ims@currentaff{\ims@aff@city}%
    }{%
      \protected@edef\ims@currentaff{\ims@currentaff, \ims@aff@city}%
    }%
  }%
  \ifdefempty{\ims@aff@country}{}{%
    \ifdefempty{\ims@currentaff}{%
      \protected@edef\ims@currentaff{\ims@aff@country}%
    }{%
      \protected@edef\ims@currentaff{\ims@currentaff, \ims@aff@country}%
    }%
  }%
  \ifstrempty{#1}{%
    \stepcounter{ims@chapter@affcounter}%
    \edef\ims@currentaffid{\number\value{ims@chapter@affcounter}}%
  }{%
    \edef\ims@currentaffid{#1}%
  }%
  \edef\ims@currentafftextcs{ims@chapter@afftext@\number\value{ims@chapter@metaid}@\ims@currentaffid}%
  \csxdef{\ims@currentafftextcs}{\expandonce{\ims@currentaff}}%
  \ims@appendaffidlist{\ims@currentaffid}%
}

\newcommand{\ims@printoneaffiliation}[1]{%
  \edef\ims@currentafftextcs{ims@chapter@afftext@\number\value{ims@chapter@metaid}@#1}%
  \@ifundefined{\ims@currentafftextcs}{}{%
    \noindent\textsuperscript{#1}\csuse{\ims@currentafftextcs}\par%
  }%
}

\newcommand{\ims@printchaptermeta}{%
  \ifdefstring{\ims@chapter@meta@printed}{1}{}{%
    \ifboolexpr{
      not test {\ifdefempty{\ims@chapter@authors}}
      or
      not test {\ifdefempty{\ims@chapter@afforder}}
      or
      not test {\ifdefempty{\ims@chapter@cortexts}}
    }{%
      \par\smallskip%
      \noindent\ims@chapter@authors%
      \ifdefempty{\ims@chapter@afforder}{}{%
        \vspace{0.35\baselineskip}%
        {\footnotesize%
          \renewcommand*{\do}[1]{\ims@printoneaffiliation{##1}}%
          \expandafter\docsvlist\expandafter{\ims@chapter@afforder}%
        }%
      }%
      \ifdefempty{\ims@chapter@cortexts}{}{%
        \vspace{0.35\baselineskip}%
        {\footnotesize\ims@chapter@cortexts}%
      }%
      \vspace{0.65\baselineskip}%
    }{}%
    \gdef\ims@chapter@meta@printed{1}%
  }%
}

\newenvironment{chapterfrontmatter}{%
  \par\vspace{0.8\baselineskip}%
  \begingroup\small\justifying%
  \ims@chapter@resetmeta%
  \let\author\ims@chapter@author
  \let\affiliation\ims@chapter@affiliation
  \let\corref\ims@chapter@corref
  \let\cortext\ims@chapter@cortext
}{%
  \ims@printchaptermeta%
  \par\endgroup\vspace{0.6\baselineskip}%
}

